/proposal/*
  X-Robots-Tag: noindex, nofollow
  Referrer-Policy: no-referrer
  Content-Security-Policy: default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self'; connect-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action https://buy.stripe.com

/payment-complete/*
  X-Robots-Tag: noindex, nofollow
  Referrer-Policy: no-referrer
  Cache-Control: no-store

/api/*
  Cache-Control: no-store
